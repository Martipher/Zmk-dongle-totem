#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <250>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        LongPress: LongPress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        HRShiftR: HRShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            quick-tap-ms = <125>;
        };

        HRShiftL: HRShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HRSHIFTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            quick-tap-ms = <125>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            quick-tap-ms = <125>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-on-release;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            quick-tap-ms = <125>;
        };

        toggleLayerPress: toggleLayerPress {
            compatible = "zmk,behavior-hold-tap";
            label = "TOGGLELAYERPRESS";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&caps_word>;
            key-positions = <34 35>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        sqt {
            bindings = <&kp DE_SQT>;
            key-positions = <16 17>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        minus {
            bindings = <&kp DE_MINUS>;
            key-positions = <13 12>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        underscore {
            bindings = <&kp DE_UNDERSCORE>;
            key-positions = <2 3>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        dqt {
            bindings = <&kp DE_DQT>;
            key-positions = <7 6>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        question {
            bindings = <&kp DE_QUESTION>;
            key-positions = <1 2>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        exclamation {
            bindings = <&kp DE_EXCLAMATION>;
            key-positions = <11 12>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        slash {
            bindings = <&kp DE_SLASH>;
            key-positions = <24 23>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        backslash {
            bindings = <&kp DE_BACKSLASH>;
            key-positions = <23 22>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        left_parenthesis {
            bindings = <&kp DE_LEFT_PARENTHESIS>;
            key-positions = <27 28>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        right_parenthesis {
            bindings = <&kp DE_RIGHT_PARENTHESIS>;
            key-positions = <28 29>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        and {
            bindings = <&kp DE_AMPERSAND>;
            key-positions = <17 18>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        pipe {
            bindings = <&kp DE_PIPE>;
            key-positions = <7 8>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        plus {
            bindings = <&kp DE_PLUS>;
            key-positions = <0 1>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        equal {
            bindings = <&kp DE_EQUAL>;
            key-positions = <10 11>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };

        asterisk {
            bindings = <&kp DE_ASTERISK>;
            key-positions = <21 22>;
            timeout-ms = <150>;
            layers = <0>;
            require-prior-idle-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        KOY {
            display-name = "KOY";
            bindings = <
                 &kp DE_K        &kp DE_PERIOD   &kp DE_O         &kp DE_COMMA           &kp DE_Y           &mt LC(DE_V) DE_V  &kp DE_G              &mt LC(DE_C) DE_C  &kp DE_L        &kp DE_ESZETT
                 &HML LGUI DE_H  &HML LALT DE_A  &HML LCTRL DE_E  &HRShiftL LSHIFT DE_I  &kp DE_U           &kp DE_D           &HRShiftR RSHFT DE_T  &HMR RCTRL DE_R    &HMR RALT DE_N  &HMR RGUI DE_S
&mt ESCAPE DE_F  &kp DE_X        &kp DE_Q        &kp DE_A_UMLAUT  &kp DE_U_UMLAUT        &kp DE_O_UMLAUT    &kp DE_B           &kp DE_P              &kp DE_W           &kp DE_M        &kp DE_J        &kp DE_Z
                                                 &lt 4 LEFT_GUI   &lt 2 TAB              &kp DE_SPACE       &kp ENTER          &lt 1 BSPC            &lt 3 DELETE
            >;
        };

        KOY+ {
            bindings = <
            &kp DE_DEGREE  &kp DE_QUESTION     &kp DE_SECTION  &kp DE_SLASH      &kp DE_BACKSLASH       &kp DE_AMPS           &kp DE_PERCENT  &kp DE_LEFT_BRACKET      &kp DE_RIGHT_BRACKET      &kp DE_ACUTE
            &kp DE_CARET   &kp DE_EXCLAMATION  &kp DE_EURO     &kp DE_MINUS      &kp DE_UNDER           &kp DE_DOUBLE_QUOTES  &kp DE_SQT      &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_GRAVE
&kp ESCAPE  &kp DE_PIPE    &kp DE_AT           &kp DE_DOLLAR   &kp DE_LESS_THAN  &kp DE_GREATER_THAN    &kp DE_ASTRK          &kp DE_HASH     &kp DE_LEFT_BRACE        &kp DE_RIGHT_BRACE        &kp DE_TILDE  &none
                                               &trans          &trans            &trans                 &trans                &trans          &trans
            >;

            label = "KOY+";
        };

        NUMBER {
            display-name = "NUMBER";
            bindings = <
                &kp DE_ASTERISK  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_MINUS    &kp DE_SUPER2  &kp DE_LESS_THAN  &kp UP_ARROW    &kp DE_GREATER_THAN  &none
                &kp DE_SLASH     &kp DE_N4  &kp DE_N5  &kp DE_N6  &kp DE_PLUS     &kp DE_SUPER3  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW      &none
&kp LEFT_SHIFT  &kp DE_N0        &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_EQUAL    &none          &none             &kp DE_COMMA    &kp DE_PERIOD        &none  &none
                                            &trans     &trans     &trans          &trans         &trans            &trans
            >;
        };

        EXTRA {
            display-name = "EXTRA";
            bindings = <
        &kp F2  &kp F3  &kp F4           &kp F5    &kp F6           &kp F7  &kp F8            &kp F9            &kp F10             &kp F11
        &none   &none   &kp PAUSE_BREAK  &kp HOME  &kp PAGE_UP      &none   &kp LC(LS(DE_T))  &kp LG(LS(DE_S))  &kp LC(LS(ESCAPE))  &none
&kp F1  &none   &none   &none            &kp END   &kp PAGE_DOWN    &none   &none             &none             &kp LC(LA(DELETE))  &none    &kp F12
                        &trans           &trans    &trans           &trans  &trans            &trans
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
       &bootloader  &studio_unlock  &none   &none   &to 5     &none   &none   &none   &none  &none
       &none        &none           &none   &none   &none     &none   &none   &none   &none  &none
&none  &none        &none           &none   &none   &none     &none   &none   &none   &none  &none  &none
                                    &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        GAME {
            display-name = "Game";
            bindings = <
         &kp DE_Y        &kp DE_X  &kp DE_C   &kp DE_V      &sl 6       &none      &none           &kp UP_ARROW    &none            &kp LS(TAB)
         &kp LALT        &kp DE_Q  &kp DE_W   &kp DE_E      &kp DE_R    &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&kp ESC  &kp LEFT_SHIFT  &kp DE_A  &kp DE_S   &kp DE_D      &kp DE_F    &none      &none           &none           &none            &none        &kp TAB
                                   &kp LCTRL  &kp LEFT_ALT  &trans      &kp ENTER  &trans          &kp LEFT_GUI
            >;
        };

        GAME+ {
            display-name = "Game+";
            bindings = <
         &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5    &kp DE_Z  &kp DE_U  &kp DE_I  &kp DE_O  &kp DE_P
         &kp DE_N6  &kp DE_N7  &trans     &kp DE_N8  &kp DE_G     &kp DE_H  &kp DE_J  &kp DE_K  &kp DE_L  &kp F12
&kp TAB  &to 0      &trans     &trans     &trans     &kp DE_N9    &kp DE_N  &kp DE_M  &kp F5    &kp F3    &kp F22   &kp LA(F4)
                               &trans     &trans     &trans       &trans    &trans    &trans
            >;
        };
    };
};
